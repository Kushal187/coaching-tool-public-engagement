# ──────────────────────────────────────────────
# Weaviate connection
# ──────────────────────────────────────────────
# For Weaviate Cloud (WCD):
WEAVIATE_HOST=your-cluster.weaviate.network
WEAVIATE_API_KEY=your-weaviate-api-key
WEAVIATE_SCHEME=https

# For local Docker Weaviate (uncomment):
# WEAVIATE_HOST=localhost:8080
# WEAVIATE_API_KEY=
# WEAVIATE_SCHEME=http

# ──────────────────────────────────────────────
# OpenAI
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ──────────────────────────────────────────────
# Express server (optional)
# ──────────────────────────────────────────────
# PORT=3000

# ──────────────────────────────────────────────
# Model and retrieval config (optional overrides)
# ──────────────────────────────────────────────
# Used by the orchestrator, coach (open + continue), retrieval, and suggest-next
# agents that back the unified /api/chat endpoint.
# CHATBOT_MODEL=gpt-5.1

# Max Weaviate hits returned per search_knowledge_base tool call.
# CHATBOT_MAX_RESULTS=5

# Max tool-calling iterations per coach / retrieval agent turn.
# AGENT_MAX_ITERATIONS=3

# Model used by the /api/admin/classify document classifier.
# CLASSIFY_MODEL=gpt-5.1-mini
